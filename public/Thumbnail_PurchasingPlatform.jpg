<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%" style="background:#173d72; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <defs>
    <!-- Embedded Handwriting Font (Architects Daughter) for Self-Contained SVG Rendering -->
    <style>
      @font-face {
        font-family: 'Architects Daughter';
        font-style: normal;
        font-weight: 400;
        src: url('data:font/woff2;base64,') format('woff2');
      }
      #blueprintDiagrams text, #blueprintDiagrams tspan {
        font-family: 'Architects Daughter', 'Caveat', 'Chalkboard SE', 'Chalkboard', 'Bradley Hand', 'Segoe Print', cursive !important;
      }
    </style>
    <!-- Background Vignette -->
    <radialGradient id="chalkGlow" cx="50%" cy="46%" r="65%">
      <stop offset="0%" stop-color="#2d66bd" stop-opacity="1"/>
      <stop offset="60%" stop-color="#1e4a87" stop-opacity="1"/>
      <stop offset="100%" stop-color="#122e57" stop-opacity="1"/>
    </radialGradient>

    <!-- Card Drop Shadows -->
    <filter id="shadow-main" x="-15%" y="-15%" width="135%" height="140%">
      <feDropShadow dx="-10" dy="25" stdDeviation="28" flood-color="#000000" flood-opacity="0.65"/>
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.4"/>
    </filter>

    <filter id="shadow-mobile" x="-25%" y="-20%" width="155%" height="150%">
      <feDropShadow dx="12" dy="28" stdDeviation="22" flood-color="#000000" flood-opacity="0.7"/>
      <feDropShadow dx="2" dy="6" stdDeviation="8" flood-color="#000000" flood-opacity="0.35"/>
    </filter>

    <filter id="shadow-back" x="-10%" y="-10%" width="125%" height="130%">
      <feDropShadow dx="-6" dy="16" stdDeviation="18" flood-color="#000000" flood-opacity="0.55"/>
    </filter>

    <!-- Chalk Line Style -->
    <filter id="chalk-rough">
      <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.5" xChannelSelector="R" yChannelSelector="G"/>
    </filter>

    <!-- Linear Gradients -->
    <linearGradient id="headerGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>

    <linearGradient id="primaryBtn" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10b981"/>
      <stop offset="100%" stop-color="#059669"/>
    </linearGradient>

    <linearGradient id="logoBlue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#1d4ed8"/>
    </linearGradient>

    <linearGradient id="phoneBorder" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#475569"/>
      <stop offset="50%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>

    <!-- Subtle Dot Pattern for UX blueprint mood -->
    <pattern id="dotGrid" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="0.8" fill="#ffffff" fill-opacity="0.04"/>
    </pattern>
  </defs>

  <!-- Background Layer -->
  <rect width="1200" height="800" fill="url(#chalkGlow)"/>
  <rect width="1200" height="800" fill="url(#dotGrid)"/>

  <!-- ========================================== -->
  <!-- BACKGROUND CHALK SKETCHES (UX Ideation)     -->
  <!-- ========================================== -->
  <g id="blueprintDiagrams" opacity="0.82" stroke="#ffffff" stroke-width="1.2" fill="none" font-family="'Architects Daughter', 'Caveat', 'Chalkboard SE', 'Chalkboard', 'Bradley Hand', 'Segoe Print', cursive" stroke-linecap="round" stroke-linejoin="round">
    <!-- Left Hand Chalk Flow: Breadcrumb Tree -->
    <text x="50" y="80" font-size="13"  fill="#ffffff" stroke="none">Home &gt; Appliances &gt; Range &gt; Range Top</text>
    <path d="M 50 95 L 220 95"/>
    
    <!-- Wireframe sketch box 1 -->
    <rect x="50" y="115" width="130" height="85" stroke-dasharray="3,3"/>
    <line x1="50" y1="115" x2="180" y2="200" stroke-dasharray="2,2"/>
    <line x1="180" y1="115" x2="50" y2="200" stroke-dasharray="2,2"/>
    <text x="50" y="220" font-size="11" fill="#e2e8f0" stroke="none">Quantity [Add to Cart: 4]</text>

    <!-- Services sketch list -->
    <text x="50" y="255" font-size="12" font-weight="600" fill="#ffffff" stroke="none">Services &amp; Delivery</text>
    <rect x="50" y="270" width="160" height="24" rx="3"/>
    <rect x="50" y="302" width="160" height="24" rx="3"/>
    <rect x="50" y="334" width="160" height="24" rx="3"/>
    <text x="60" y="286" font-size="10" fill="#e2e8f0" stroke="none">• In-home uncrate &amp; inspect</text>
    <text x="60" y="318" font-size="10" fill="#e2e8f0" stroke="none">• Haul-away old range</text>
    <text x="60" y="350" font-size="10" fill="#e2e8f0" stroke="none">• Gas flex line kit ($14.66)</text>

    <!-- Chalk Arrow -->
    <path d="M 175 390 Q 220 420 280 410" stroke-width="1.8" marker-end="url(#arrow)"/>
    <text x="60" y="420" font-size="11" fill="#38bdf8" stroke="none" font-weight="bold">Iterate Flow A/B</text>

    <!-- Right Hand Chalk Wireframe (Product Details & Specs) -->
    <text x="960" y="90" font-size="13"  fill="#ffffff" stroke="none">Product Details (Matrix)</text>
    <rect x="960" y="105" width="190" height="110" stroke-dasharray="4,3"/>
    <line x1="960" y1="132" x2="1150" y2="132"/>
    <line x1="960" y1="158" x2="1150" y2="158"/>
    <line x1="960" y1="184" x2="1150" y2="184"/>
    <line x1="1040" y1="105" x2="1040" y2="215"/>
    <text x="970" y="123" font-size="9" fill="#e2e8f0" stroke="none">Fuel</text>
    <text x="1050" y="123" font-size="9" fill="#e2e8f0" stroke="none">Natural Gas</text>
    <text x="970" y="149" font-size="9" fill="#e2e8f0" stroke="none">Capacity</text>
    <text x="1050" y="149" font-size="9" fill="#e2e8f0" stroke="none">5.1 cu ft</text>
    <text x="970" y="175" font-size="9" fill="#e2e8f0" stroke="none">Burners</text>
    <text x="1050" y="175" font-size="9" fill="#e2e8f0" stroke="none">4 Sealed</text>
    <text x="970" y="201" font-size="9" fill="#e2e8f0" stroke="none">Clean</text>
    <text x="1050" y="201" font-size="9" fill="#e2e8f0" stroke="none">Standard</text>

    <!-- Chalk notes at bottom right -->
    <text x="970" y="250" font-size="11" fill="#ffffff" stroke="none">Frequently Bought Together</text>
    <rect x="970" y="265" width="45" height="40"/>
    <rect x="1025" y="265" width="45" height="40"/>
    <rect x="1080" y="265" width="45" height="40"/>
    <text x="980" y="320" font-size="9" fill="#e2e8f0" stroke="none">$71.99</text>
    <text x="1035" y="320" font-size="9" fill="#e2e8f0" stroke="none">$800.50</text>
    <text x="1090" y="320" font-size="9" fill="#e2e8f0" stroke="none">$1,032</text>
  </g>

  <!-- ========================================== -->
  <!-- LAYER 2: BACKGROUND DESKTOP WIREFRAME      -->
  <!-- (Angled behind main card for depth)        -->
  <!-- ========================================== -->
  <g transform="translate(180, 70) rotate(-2)" filter="url(#shadow-back)" opacity="0.6">
    <rect width="700" height="520" rx="10" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1.5"/>
    <!-- Wireframe Header -->
    <rect width="700" height="42" rx="10" fill="#1e293b"/>
    <rect x="20" y="14" width="22" height="14" rx="2" fill="#3b82f6"/>
    <rect x="55" y="12" width="240" height="18" rx="4" fill="#334155"/>
    <!-- Body wireframe blocks -->
    <rect x="25" y="60" width="160" height="240" rx="6" fill="#f1f5f9" stroke="#e2e8f0"/>
    <rect x="205" y="60" width="470" height="24" rx="4" fill="#e2e8f0"/>
    <rect x="205" y="95" width="320" height="14" rx="3" fill="#f1f5f9"/>
    <rect x="205" y="120" width="180" height="32" rx="4" fill="#10b981" opacity="0.8"/>
    <!-- Catalog grid -->
    <rect x="25" y="320" width="150" height="160" rx="4" fill="#ffffff" stroke="#e2e8f0"/>
    <rect x="195" y="320" width="150" height="160" rx="4" fill="#ffffff" stroke="#e2e8f0"/>
    <rect x="365" y="320" width="150" height="160" rx="4" fill="#ffffff" stroke="#e2e8f0"/>
    <rect x="535" y="320" width="140" height="160" rx="4" fill="#ffffff" stroke="#e2e8f0"/>
  </g>

  <!-- ========================================== -->
  <!-- LAYER 3: HERO WIREFRAME CARD (Tilted Main) -->
  <!-- ========================================== -->
  <g transform="translate(230, 95) rotate(-3.5)" filter="url(#shadow-main)">
    <!-- Base Card Container -->
    <rect width="730" height="570" rx="12" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5"/>

    <!-- App Header Bar -->
    <rect width="730" height="50" rx="12" fill="#1e293b"/>
    <rect y="40" width="730" height="10" fill="#1e293b"/> <!-- square bottom corners -->

    <!-- Brand Logo "P" inside Blue Rounded Box -->
    <rect x="22" y="12" width="26" height="26" rx="5" fill="url(#logoBlue)"/>
    <text x="31" y="30" font-size="16" font-weight="900" fill="#ffffff" font-family="'Segoe UI', Roboto, sans-serif">P</text>
    <text x="56" y="29" font-size="13" font-weight="700" fill="#f8fafc" letter-spacing="0.5">Purchasing Platform</text>

    <!-- Global Search Input in Header -->
    <rect x="225" y="11" width="310" height="28" rx="4" fill="#0f172a" stroke="#334155" stroke-width="1"/>
    <text x="238" y="29" font-size="11" fill="#e2e8f0">Search ranges, stoves, SKU, vendor...</text>
    <rect x="465" y="11" width="70" height="28" rx="4" fill="#2563eb"/>
    <text x="479" y="28" font-size="10.5" font-weight="700" fill="#ffffff" letter-spacing="0.5">SEARCH</text>

    <!-- User / Cart Nav Icons -->
    <rect x="620" y="16" width="36" height="18" rx="9" fill="#334155"/>
    <text x="628" y="29" font-size="10" font-weight="600" fill="#38bdf8">CART 4</text>
    <circle cx="682" cy="25" r="11" fill="#475569"/>
    <text x="678" y="29" font-size="10" font-weight="bold" fill="#ffffff">LP</text>

    <!-- Subheader / Breadcrumbs -->
    <rect y="50" width="730" height="28" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
    <text x="25" y="68" font-size="10.5" fill="#64748b">
      Home <tspan fill="#e2e8f0">&gt;</tspan> Appliances <tspan fill="#e2e8f0">&gt;</tspan> Kitchen Ranges <tspan fill="#e2e8f0">&gt;</tspan> <tspan font-weight="600" fill="#0f172a">Whirlpool 30" Gas Range</tspan>
    </text>

    <!-- ======================================== -->
    <!-- PRODUCT DETAIL VIEW: LEFT (Image Wireframe)-->
    <!-- ======================================== -->
    <g transform="translate(25, 90)">
      <!-- Main Photo Placeholder with X -->
      <rect width="250" height="220" rx="8" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1.2"/>
      <line x1="0" y1="0" x2="250" y2="220" stroke="#e2e8f0" stroke-width="1"/>
      <line x1="250" y1="0" x2="0" y2="220" stroke="#e2e8f0" stroke-width="1"/>

      <!-- Stovetop Sketch Representation inside photo placeholder -->
      <g transform="translate(35, 25)" stroke="#64748b" stroke-width="1.8" fill="none">
        <!-- Backguard / Control Panel -->
        <rect x="25" y="10" width="130" height="28" rx="2" fill="#e2e8f0"/>
        <circle cx="50" cy="24" r="4" fill="#e2e8f0"/>
        <circle cx="70" cy="24" r="4" fill="#e2e8f0"/>
        <rect x="85" y="18" width="30" height="12" rx="1" fill="#ffffff"/>
        <circle cx="125" cy="24" r="4" fill="#e2e8f0"/>
        <circle cx="140" cy="24" r="4" fill="#e2e8f0"/>
        
        <!-- Cooktop Surface -->
        <polygon points="10,50 170,50 180,105 0,105" fill="#f8fafc" stroke="#64748b" stroke-width="1.5"/>
        <!-- 4 Burners -->
        <ellipse cx="45" cy="72" rx="16" ry="10" stroke="#475569" stroke-width="2"/>
        <ellipse cx="135" cy="72" rx="16" ry="10" stroke="#475569" stroke-width="2"/>
        <ellipse cx="55" cy="92" rx="18" ry="8" stroke="#475569" stroke-width="2"/>
        <ellipse cx="125" cy="92" rx="18" ry="8" stroke="#475569" stroke-width="2"/>

        <!-- Oven Window & Door Handle -->
        <rect x="15" y="112" width="150" height="52" rx="3" fill="#e2e8f0" stroke="#64748b"/>
        <rect x="35" y="122" width="110" height="34" rx="2" fill="#334155"/>
        <line x1="25" y1="116" x2="155" y2="116" stroke="#0f172a" stroke-width="3"/>
      </g>

      <!-- Zoom indicator pill -->
      <rect x="175" y="188" width="65" height="22" rx="4" fill="#ffffff" stroke="#cbd5e1"/>
      <circle cx="188" cy="199" r="4.5" stroke="#3b82f6" stroke-width="1.5" fill="none"/>
      <line x1="191" y1="202" x2="195" y2="206" stroke="#3b82f6" stroke-width="1.5"/>
      <text x="199" y="203" font-size="9" font-weight="600" fill="#475569">ZOOM</text>

      <!-- Thumbnail Strip -->
      <g transform="translate(0, 230)">
        <rect x="0" width="55" height="42" rx="4" fill="#ffffff" stroke="#2563eb" stroke-width="2"/>
        <rect x="65" width="55" height="42" rx="4" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1"/>
        <rect x="130" width="55" height="42" rx="4" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1"/>
        <rect x="195" width="55" height="42" rx="4" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1"/>
        <!-- Thumbnail mini line indicators -->
        <line x1="10" y1="21" x2="45" y2="21" stroke="#94a3b8" stroke-width="1.5"/>
        <line x1="75" y1="21" x2="110" y2="21" stroke="#cbd5e1" stroke-width="1.5"/>
        <line x1="140" y1="21" x2="175" y2="21" stroke="#cbd5e1" stroke-width="1.5"/>
        <line x1="205" y1="21" x2="240" y2="21" stroke="#cbd5e1" stroke-width="1.5"/>
      </g>
    </g>

    <!-- ======================================== -->
    <!-- PRODUCT DETAIL VIEW: RIGHT (Product Info)-->
    <!-- ======================================== -->
    <g transform="translate(295, 90)">
      <!-- Title -->
      <text x="0" y="16" font-size="16" font-weight="700" fill="#0f172a" letter-spacing="-0.2">
        Whirlpool 30" Black, Gas, Standard Clean Range / Stove
      </text>

      <!-- Metadata & Ratings -->
      <g transform="translate(0, 26)">
        <text x="0" y="12" font-size="10" fill="#64748b">Item # 482910 &nbsp;|&nbsp; Model # WFG320M0BB &nbsp;|&nbsp; </text>
        <text x="180" y="12" font-size="11" fill="#f59e0b">★★★★☆</text>
        <text x="235" y="12" font-size="10" font-weight="600" fill="#2563eb">4.4 (182 reviews)</text>
      </g>

      <!-- Price Box -->
      <g transform="translate(0, 52)">
        <rect width="410" height="52" rx="6" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
        <text x="14" y="32" font-size="24" font-weight="800" fill="#0f172a">$466.99</text>
        <text x="120" y="30" font-size="12" fill="#e2e8f0" text-decoration="line-through">$549.00</text>
        <rect x="180" y="16" width="62" height="20" rx="3" fill="#fee2e2"/>
        <text x="188" y="30" font-size="10" font-weight="700" fill="#dc2626">SAVE $82</text>
        <text x="260" y="30" font-size="10.5" font-weight="600" fill="#059669">● In Stock (Hub: Central)</text>
      </g>

      <!-- Actions: Quantity & Add to Cart -->
      <g transform="translate(0, 114)">
        <!-- Qty Picker -->
        <rect width="75" height="34" rx="4" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
        <text x="12" y="22" font-size="13" font-weight="600" fill="#0f172a">Qty: 1</text>
        <path d="M 58 18 L 63 23 L 68 18" stroke="#64748b" stroke-width="1.5" fill="none"/>

        <!-- Add to Cart CTA Button -->
        <rect x="88" width="195" height="34" rx="4" fill="url(#primaryBtn)"/>
        <text x="135" y="22" font-size="12" font-weight="700" fill="#ffffff" letter-spacing="0.3">+ ADD TO CART</text>

        <!-- Save Button -->
        <rect x="292" width="118" height="34" rx="4" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
        <text x="312" y="22" font-size="11" font-weight="600" fill="#475569">Save to List</text>
      </g>

      <!-- Specifications Grid (Matrix) -->
      <g transform="translate(0, 160)">
        <text x="0" y="12" font-size="11" font-weight="700" fill="#1e293b" letter-spacing="0.2">KEY SPECIFICATIONS</text>
        <rect y="18" width="410" height="96" rx="5" fill="#ffffff" stroke="#e2e8f0" stroke-width="1"/>
        
        <!-- Row 1 -->
        <rect x="0" y="18" width="120" height="24" fill="#f8fafc"/>
        <text x="10" y="34" font-size="10" font-weight="600" fill="#64748b">Fuel Type</text>
        <text x="130" y="34" font-size="10" fill="#0f172a">Gas (Natural / LP Convertible)</text>
        <line x1="0" y1="42" x2="410" y2="42" stroke="#f1f5f9"/>

        <!-- Row 2 -->
        <rect x="0" y="42" width="120" height="24" fill="#f8fafc"/>
        <text x="10" y="58" font-size="10" font-weight="600" fill="#64748b">Total Capacity</text>
        <text x="130" y="58" font-size="10" fill="#0f172a">5.1 cu. ft.</text>
        <line x1="0" y1="66" x2="410" y2="66" stroke="#f1f5f9"/>

        <!-- Row 3 -->
        <rect x="0" y="66" width="120" height="24" fill="#f8fafc"/>
        <text x="10" y="82" font-size="10" font-weight="600" fill="#64748b">Burner Type</text>
        <text x="130" y="82" font-size="10" fill="#0f172a">4 Sealed Burners w/ SpeedHeat™</text>
        <line x1="0" y1="90" x2="410" y2="90" stroke="#f1f5f9"/>

        <!-- Row 4 -->
        <rect x="0" y="90" width="120" height="24" fill="#f8fafc"/>
        <text x="10" y="106" font-size="10" font-weight="600" fill="#64748b">Cleaning Method</text>
        <text x="130" y="106" font-size="10" fill="#0f172a">Manual / Standard Clean</text>
      </g>
    </g>

    <!-- ======================================== -->
    <!-- CROSS-SELL / RECOMMENDATION CAROUSEL     -->
    <!-- ======================================== -->
    <g transform="translate(25, 385)">
      <line x1="0" y1="0" x2="680" y2="0" stroke="#e2e8f0" stroke-width="1"/>
      <text x="0" y="18" font-size="11" font-weight="700" fill="#1e293b" letter-spacing="0.3">FREQUENTLY BOUGHT TOGETHER</text>

      <!-- Item 1: Gas line kit -->
      <g transform="translate(0, 28)">
        <rect width="158" height="135" rx="6" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
        <rect x="10" y="8" width="138" height="60" rx="4" fill="#ffffff" stroke="#cbd5e1" stroke-width="0.8"/>
        <!-- sketch icon -->
        <path d="M 45 38 Q 80 18 115 38" stroke="#64748b" stroke-width="3" fill="none"/>
        <text x="10" y="82" font-size="9.5" font-weight="600" fill="#0f172a">Smart Choice Gas Line</text>
        <text x="10" y="95" font-size="8.5" fill="#64748b">4 ft. Universal flex kit</text>
        <text x="10" y="112" font-size="12" font-weight="700" fill="#0f172a">$71.99</text>
        <rect x="100" y="100" width="48" height="20" rx="3" fill="#2563eb"/>
        <text x="110" y="113" font-size="8.5" font-weight="bold" fill="#ffffff">+ ADD</text>
      </g>

      <!-- Item 2: Range hood -->
      <g transform="translate(172, 28)">
        <rect width="158" height="135" rx="6" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
        <rect x="10" y="8" width="138" height="60" rx="4" fill="#ffffff" stroke="#cbd5e1" stroke-width="0.8"/>
        <polygon points="30,55 125,55 110,22 45,22" stroke="#64748b" stroke-width="1.5" fill="#f1f5f9"/>
        <text x="10" y="82" font-size="9.5" font-weight="600" fill="#0f172a">Broan 30" Under-Cabinet</text>
        <text x="10" y="95" font-size="8.5" fill="#64748b">Convertible Hood Black</text>
        <text x="10" y="112" font-size="12" font-weight="700" fill="#0f172a">$71.30</text>
        <rect x="100" y="100" width="48" height="20" rx="3" fill="#2563eb"/>
        <text x="110" y="113" font-size="8.5" font-weight="bold" fill="#ffffff">+ ADD</text>
      </g>

      <!-- Item 3: Refrigerator -->
      <g transform="translate(344, 28)">
        <rect width="158" height="135" rx="6" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
        <rect x="10" y="8" width="138" height="60" rx="4" fill="#ffffff" stroke="#cbd5e1" stroke-width="0.8"/>
        <rect x="60" y="14" width="38" height="48" rx="2" stroke="#64748b" stroke-width="1.5" fill="#f1f5f9"/>
        <line x1="60" y1="32" x2="98" y2="32" stroke="#64748b" stroke-width="1"/>
        <text x="10" y="82" font-size="9.5" font-weight="600" fill="#0f172a">Whirlpool 18 cu ft Top</text>
        <text x="10" y="95" font-size="8.5" fill="#64748b">Freezer Fridge Black</text>
        <text x="10" y="112" font-size="12" font-weight="700" fill="#0f172a">$800.50</text>
        <rect x="100" y="100" width="48" height="20" rx="3" fill="#2563eb"/>
        <text x="110" y="113" font-size="8.5" font-weight="bold" fill="#ffffff">+ ADD</text>
      </g>

      <!-- Item 4: Dishwasher -->
      <g transform="translate(516, 28)">
        <rect width="164" height="135" rx="6" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
        <rect x="10" y="8" width="144" height="60" rx="4" fill="#ffffff" stroke="#cbd5e1" stroke-width="0.8"/>
        <rect x="62" y="16" width="40" height="44" rx="2" stroke="#64748b" stroke-width="1.5" fill="#f1f5f9"/>
        <line x1="68" y1="22" x2="96" y2="22" stroke="#0f172a" stroke-width="2"/>
        <text x="10" y="82" font-size="9.5" font-weight="600" fill="#0f172a">Whirlpool Dishwasher</text>
        <text x="10" y="95" font-size="8.5" fill="#64748b">Heavy-Duty Clean Black</text>
        <text x="10" y="112" font-size="12" font-weight="700" fill="#0f172a">$1,032.16</text>
        <rect x="106" y="100" width="48" height="20" rx="3" fill="#2563eb"/>
        <text x="116" y="113" font-size="8.5" font-weight="bold" fill="#ffffff">+ ADD</text>
      </g>
    </g>
  </g>

  <!-- ========================================== -->
  <!-- LAYER 4: MOBILE WIREFRAME DEVICE (Front)   -->
  <!-- ========================================== -->
  <g transform="translate(860, 240) rotate(5.5)" filter="url(#shadow-mobile)">
    <!-- Smartphone Outer Bezel -->
    <rect width="230" height="460" rx="34" fill="url(#phoneBorder)" stroke="#64748b" stroke-width="2"/>
    <!-- Screen Glass -->
    <rect x="7" y="7" width="216" height="446" rx="28" fill="#ffffff"/>

    <!-- Speaker Notch Pill -->
    <rect x="80" y="14" width="70" height="14" rx="7" fill="#0f172a"/>
    <circle cx="138" cy="21" r="3" fill="#1e293b"/>

    <!-- Mobile Status Bar -->
    <text x="24" y="24" font-size="9.5" font-weight="700" fill="#0f172a">5:08</text>
    <path d="M 188 18 L 196 24 L 188 24 Z" fill="#0f172a"/>
    <rect x="198" y="18" width="12" height="6" rx="1.5" fill="#0f172a"/>

    <!-- Mobile Nav Bar -->
    <g transform="translate(14, 38)">
      <rect width="202" height="34" rx="6" fill="#1e293b"/>
      <!-- Back Arrow -->
      <path d="M 18 17 L 12 17 M 15 13 L 11 17 L 15 21" stroke="#ffffff" stroke-width="1.8" fill="none" stroke-linecap="round"/>
      <text x="28" y="21" font-size="10.5" font-weight="600" fill="#ffffff">Whirlpool 30" Range</text>
      <!-- Cart Icon -->
      <circle cx="182" cy="17" r="7" fill="#38bdf8"/>
      <text x="180" y="20" font-size="8.5" font-weight="bold" fill="#0f172a">4</text>
    </g>

    <!-- Mobile Product Image Placeholder -->
    <g transform="translate(14, 80)">
      <rect width="202" height="150" rx="6" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
      <line x1="0" y1="0" x2="202" y2="150" stroke="#f1f5f9" stroke-width="1"/>
      <line x1="202" y1="0" x2="0" y2="150" stroke="#f1f5f9" stroke-width="1"/>
      
      <!-- Mini stove sketch -->
      <g transform="translate(42, 22)" stroke="#64748b" stroke-width="1.4" fill="none">
        <rect x="15" y="8" width="90" height="18" rx="2" fill="#e2e8f0"/>
        <polygon points="5,35 115,35 120,68 0,68" fill="#ffffff" stroke="#64748b"/>
        <ellipse cx="32" cy="48" rx="12" ry="6" stroke="#475569"/>
        <ellipse cx="88" cy="48" rx="12" ry="6" stroke="#475569"/>
        <rect x="10" y="72" width="100" height="35" rx="2" fill="#e2e8f0"/>
        <rect x="25" y="78" width="70" height="22" rx="1" fill="#334155"/>
      </g>

      <!-- Carousel dots -->
      <circle cx="91" cy="140" r="2.5" fill="#2563eb"/>
      <circle cx="101" cy="140" r="2" fill="#ffffff"/>
      <circle cx="111" cy="140" r="2" fill="#ffffff"/>
    </g>

    <!-- Mobile Product Details -->
    <g transform="translate(18, 240)">
      <text x="0" y="12" font-size="11" font-weight="700" fill="#0f172a">Whirlpool 30" Gas Range</text>
      <text x="0" y="25" font-size="9" fill="#64748b">Model # WFG320M0BB • 5.1 cu ft</text>

      <text x="0" y="48" font-size="18" font-weight="800" fill="#0f172a">$466.99</text>
      <text x="80" y="46" font-size="10" fill="#e2e8f0" text-decoration="line-through">$549.00</text>

      <!-- Feature badges -->
      <rect x="0" y="58" width="88" height="18" rx="9" fill="#f1f5f9"/>
      <text x="8" y="70" font-size="8" font-weight="600" fill="#475569">✓ SpeedHeat™</text>
      <rect x="94" y="58" width="98" height="18" rx="9" fill="#f1f5f9"/>
      <text x="102" y="70" font-size="8" font-weight="600" fill="#475569">✓ In-Stock Delivery</text>

      <!-- Specifications accordion strip -->
      <rect x="0" y="86" width="194" height="26" rx="4" fill="#f8fafc" stroke="#e2e8f0"/>
      <text x="10" y="102" font-size="9.5" font-weight="600" fill="#1e293b">Specifications &amp; Dimensions</text>
      <path d="M 176 98 L 180 102 L 184 98" stroke="#64748b" stroke-width="1.5" fill="none"/>

      <!-- Sticky Mobile CTA Button -->
      <rect x="0" y="122" width="194" height="38" rx="6" fill="url(#primaryBtn)"/>
      <text x="56" y="145" font-size="11.5" font-weight="700" fill="#ffffff" letter-spacing="0.4">+ ADD TO CART</text>
    </g>

    <!-- Home Indicator bar -->
    <rect x="75" y="440" width="80" height="4" rx="2" fill="#e2e8f0"/>
  </g>
</svg>
